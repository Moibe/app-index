# Copia este archivo a `.env` EN EL DROPLET (NO lo commitees). Lo leen el deploy y pm2.
# Comentarios siempre en su propia línea: `node --env-file` (npm run db:migrate, node build en local)
# NO quita los que van al final de la línea y los deja pegados al valor.

# Puerto de esta app: el mismo en el droplet y en el dev local (vite.config.ts)
PORT=4600
# Siempre localhost; nginx hace el proxy reverso
HOST=127.0.0.1
# Requerido por SvelteKit para aceptar POST/form-actions en prod
ORIGIN=https://app-index.moibe.me
# SQLite (better-sqlite3 + drizzle)
DATABASE_URL=./local.db

# --- Login del dashboard ---
ADMIN_PASSWORD=

# --- Namecheap API (el ApiKey NO tiene modo solo-lectura: puede renovar, cambiar DNS y transferir) ---
# ApiUser y UserName son tu usuario de Namecheap (normalmente el mismo valor en ambos)
NAMECHEAP_API_USER=
NAMECHEAP_USERNAME=
NAMECHEAP_API_KEY=
# IP pública desde la que sale la llamada; DEBE estar en la whitelist de Namecheap
# (en el droplet: 165.22.53.200; en local: la IP de tu laptop)
NAMECHEAP_CLIENT_IP=

# --- DigitalOcean: token con scopes de SOLO LECTURA (domain:read, droplet:read) ---
DO_TOKEN=
